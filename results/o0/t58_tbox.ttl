qsr:PO a owl:ObjectProperty ;
    rdfs:label "rcc8_PO" ;
    rdfs:comment "x partially overlaps y: region(x) and region(y) share a cell and neither contains the other. Grounding: region(x) = cells of x plus the cells x encloses (cells outside x not 4-connected to the grid border through cells outside x); the second argument is an object; x != y. Randell, Cui & Cohn 1992 (RCC-8)." ;
    owl:propertyChainAxiom _:N1aaaa2e1e3bb4ff2b28eb280a1367c60,
        _:Nd3801c91a14e480aa1c0b7c0ee55f30a .

