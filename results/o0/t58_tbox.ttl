[] a owl:Axiom ;
    rdfs:comment "hollow_rect <= has_hole: hollow_rect requires has_hole(pix); has_hole(pix) floods the free cells of the bbox plus a one-cell margin from the corner exactly as interior(pix) does (its early False is for bboxes thinner than 3, where nothing can be enclosed), so it is true iff interior(pix) is non-empty, the test for 'has_hole'" ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource lat:hollow_rect ;
    owl:annotatedTarget lat:has_hole .

