qsr:TPP a owl:ObjectProperty ;
    rdfs:label "rcc8_TPP" ;
    rdfs:comment "x is a tangential proper part of y: region(x) is a proper subset of region(y) and some cell of region(x) is 4-adjacent to a cell outside region(y) or on the grid border. Grounding: region(x) = cells of x plus the cells x encloses (cells outside x not 4-connected to the grid border through cells outside x); the second argument is an object; x != y. Randell, Cui & Cohn 1992 (RCC-8)." ;
    rdfs:subPropertyOf qsr:PP ;
    owl:propertyChainAxiom _:N33c767dcc0cb4a92861709867d264714,
        _:N77eed6887e094a688b71f0fca4bdafff .

qsr:TPPi a owl:ObjectProperty ;
    rdfs:label "rcc8_TPPi" ;
    rdfs:comment "y is a tangential proper part of x (inverse of TPP): region(y) is a proper subset of region(x) and some cell of region(y) is 4-adjacent to a cell outside region(x) or on the grid border. Grounding: region(x) = cells of x plus the cells x encloses (cells outside x not 4-connected to the grid border through cells outside x); the second argument is an object; x != y. Randell, Cui & Cohn 1992 (RCC-8)." ;
    rdfs:subPropertyOf qsr:PPi ;
    owl:propertyChainAxiom _:N0f242820353b472e8dd8f855a9f34e90,
        _:N6f0ff2fe28e749f18579435ac854294e .

qsr:aligned a owl:ObjectProperty ;
    rdfs:label "aligned" ;
    rdfs:comment "x and y (x != y) share at least one row (axis=row) or one column (axis=col): their bounding-box projections on that axis overlap. y ranges over objects. Parent of on_ray / between." .

