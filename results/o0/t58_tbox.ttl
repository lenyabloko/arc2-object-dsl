    rdfs:label "adjacent_dir" ;
    rdfs:comment "x lies immediately in direction d of y (rows grow downward): the facing sides of their bounding boxes touch with a gap of 0 cells and their projections on the other axis overlap. y ranges over objects. Specialises dir_rel for the same d (bbox contact, not pixel contact)." ;
    rdfs:subPropertyOf qsr:aligned,
        qsr:cardinal_direction .

