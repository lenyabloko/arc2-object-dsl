    rdfs:label "sym_ud" .

qsr:between a owl:ObjectProperty ;
    rdfs:label "between" ;
    rdfs:comment "Binary form of between(x, y, z) with z existentially quantified: x lies strictly between object y and some other object z (z != y, both != x) on one straight line along the axis (row, column, or either diagonal for diag), and every cell strictly between the y cell and the z cell on that line is background or a cell of x. Subsumption holds per matched axis only: between[row] <= line_of_sight[row], between[col] <= line_of_sight[col]; between[diag] has no line_of_sight counterpart (the harness checks `subsumes` at the default setting axis=row)." .

qsr:rotation_of a owl:ObjectProperty ;
    rdfs:label "rotation_of" ;
    rdfs:comment "x is y (shape and cell colours, any placement) rotated by k quarter turns clockwise; x != y; objects only." .

