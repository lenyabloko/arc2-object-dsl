qsr:EC a owl:ObjectProperty ;
    rdfs:label "rcc8_EC" ;
    rdfs:comment "x and y are externally connected: disjoint cell sets with at least one 4-adjacent pair of cells." .

qsr:translate_of a owl:ObjectProperty ;
    rdfs:label "translate_of" ;
    rdfs:comment "x and y are distinct objects with identical shape and cell colours up to a translation (normalised coloured shapes are equal)." .

<https://github.com/lenyabloko/arc2-object-dsl/ontology/t58> a owl:Ontology ;
    rdfs:comment "T58 (Fable guidance v10a) OWL 2 EL TBox generated by tools/owl/t58_export.py: concept_hierarchy.ttl classes, subclass axioms and its 11 property chains; ontology_links.ttl classes and subclass axioms; the O0 spatial roles with their declared subsumptions and deterministic RCC-8/RCC-5/Allen compositions; the lattice concept names of occupancy2.py with definitional axioms; and the lattice rules' two-attribute conjunctions as Pair_<a>_<b> classes. Axiom annotations give the source or justification of each axiom." .

