t58:ColourRole a owl:Class ;
    rdfs:label "ColourRole" ;
    rdfs:comment "G71 lattice parent class: own colour and colour frequency roles" ;
    rdfs:subClassOf t58:MATCHING .

lat:touches_other a owl:Class ;
    rdfs:label "touches_other" ;
    rdfs:subClassOf t58:Relation ;
    owl:disjointWith lat:isolated .

qsr:on_ray a owl:ObjectProperty ;
    rdfs:label "on_ray" ;
    rdfs:comment "x is on the ray cast from object y in direction d: the ray starts at every cell of y whose next position in direction d is not in y, advances one cell per step with y's own cells transparent, and ends at the grid border (stop=border) or just before the first non-background cell not in y (stop=obstacle); x (a cell or an object, x != y) is on it if any cell of x is. Setting-level subsumptions (not expressible in `subsumes`): on_ray[d,obstacle] <= on_ray[d,border] for every d; on_ray[E|W,obstacle] <= line_of_sight[row]; on_ray[N|S,obstacle] <= line_of_sight[col]; for background-cell x, line_of_sight[row] = on_ray[E,obstacle] | on_ray[W,obstacle] (col: N, S)." .

t58:PositionProperty a owl:Class ;
    rdfs:label "PositionProperty" ;
    rdfs:comment "G71 lattice parent class: position in the grid, extremes, alignment" ;
    rdfs:subClassOf t58:CONTAINMENT,
        t58:NEAR_FAR .

arga:Feature a owl:Class .

dul:Method a owl:Class .

arcm:Prior a owl:Class ;
    rdfs:subClassOf dul:Description .

t58:Relation a owl:Class ;
    rdfs:label "Relation" ;
    rdfs:comment "G71 lattice parent class: contact / containment / existential relation to another object" ;
    rdfs:subClassOf t58:CONTACT,
        t58:CONTAINMENT .

t58:ScaleProperty a owl:Class ;
    rdfs:label "ScaleProperty" ;
    rdfs:comment "G71 lattice parent class: size, size rank, hole count" ;
    rdfs:subClassOf t58:SCALE .

arcm:Mechanism a owl:Class ;
    rdfs:subClassOf arcm:Operator .

dul:Process a owl:Class .

