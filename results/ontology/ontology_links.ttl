    rdfs:label "concatenation"@en ;
    skos:exactMatch <http://dbpedia.org/resource/Concatenation> ,
        wd:Q126002 .

arcm:math.odd_one_out
    a arcm:MathConcept ;
    rdfs:label "odd one out (anomaly / outlier detection)"@en ;
    skos:closeMatch <http://dbpedia.org/resource/Anomaly_detection> ,
        wd:Q3560506 ;
    skos:related wd:Q779824 .

arcm:math.noise_reduction
    a arcm:MathConcept ;
    rdfs:label "noise reduction"@en ;
    skos:exactMatch <http://dbpedia.org/resource/Noise_reduction> ,
        wd:Q581861 .

arcm:math.dynamical_billiards
    a arcm:MathConcept ;
    rdfs:label "dynamical billiards"@en ;
    rdfs:comment "Straight free motion alternating with specular reflections at a boundary."@en ;
    skos:exactMatch <http://dbpedia.org/resource/Dynamical_billiards> ,
        wd:Q2903467 .

arcm:math.assignment_problem
    a arcm:MathConcept ;
    rdfs:label "assignment problem (matching)"@en ;
    skos:exactMatch <http://dbpedia.org/resource/Assignment_problem> ,
        wd:Q620614 .

# ---------------------------------------------------------------- task categories (arcm:concerns = upper-level kind of entity the category is about)
arcm:category.structure
    a arcm:Category ;
    rdfs:label "Structure"@en ;
    rdfs:comment "what objects the grid contains"@en ;
    arcm:concerns dul:PhysicalObject .

arcm:category.colour
    a arcm:Category ;
    rdfs:label "Colour"@en ;
    rdfs:comment "how colours are chosen or mapped"@en ;
    arcm:concerns dul:Quality ;
    skos:related <http://dbpedia.org/resource/Color> ,
        wd:Q1075 .

arcm:category.canvas
    a arcm:Category ;
    rdfs:label "Canvas"@en ;
    rdfs:comment "what stays fixed and what is edited in place"@en ;
    arcm:concerns dul:SpaceRegion .

arcm:category.extent
    a arcm:Category ;
    rdfs:label "Extent"@en ;
    rdfs:comment "how the output grid size relates to the input"@en ;
    arcm:concerns dul:Region .

arcm:category.guide
    a arcm:Category ;
    rdfs:label "Guide & selector"@en ;
    rdfs:comment "a structure that selects or explains another region"@en ;
    skos:broader arcm:category.structure ;
    arcm:concerns dul:Role .

arcm:category.partition
    a arcm:Category ;
    rdfs:label "Partition & separators"@en ;
    rdfs:comment "separator lines split the grid into panels or lanes"@en ;
    skos:broader arcm:category.guide ,
        arcm:category.structure ;
    arcm:concerns dul:Configuration ;
    skos:related <http://dbpedia.org/resource/Partition_of_a_set> ,
        wd:Q381060 .

arcm:category.key
    a arcm:Category ;
    rdfs:label "Key, legend & glyph"@en ;
    rdfs:comment "a small mark or legend defines colours or shapes used elsewhere"@en ;
    skos:broader arcm:category.guide ;
    arcm:concerns dul:InformationObject ;
    skos:related wd:Q1200435 .

arcm:category.path
    a arcm:Category ;
    rdfs:label "Paths & lines"@en ;
    rdfs:comment "connected runs, rays and polylines"@en ;
    skos:broader arcm:category.structure ;
    arcm:concerns dul:PhysicalObject ;
    skos:related <http://dbpedia.org/resource/Polygonal_chain> ,
        wd:Q633674 .

arcm:category.corner
    a arcm:Category ;
    rdfs:label "Corners & local shape"@en ;
    rdfs:comment "corners, crosses, protrusions and small shape motifs"@en ;
    skos:broader arcm:category.structure ;
    arcm:concerns obo:BFO_0000024 .

arcm:category.cavity
    a arcm:Category ;
    rdfs:label "Cavity & fit"@en ;
    rdfs:comment "a shape fills or fits negative space"@en ;
    skos:broader arcm:category.structure ;
    arcm:concerns obo:BFO_0000029 .

arcm:category.layout
    a arcm:Category ;
    rdfs:label "Layout & lattice"@en ;
    rdfs:comment "components arranged in slots, quadrants or a lattice"@en ;
    skos:broader arcm:category.structure ,
        arcm:category.extent ;
    arcm:concerns dul:Configuration .

arcm:category.template
    a arcm:Category ;
    rdfs:label "Exemplar & template"@en ;
    rdfs:comment "one instance is copied or stamped onto others"@en ;
    skos:broader arcm:category.structure ,
        arcm:category.key ;
    arcm:concerns dul:InformationObject ;
    skos:related <http://dbpedia.org/resource/Template_matching> ,
        wd:Q3983303 .

arcm:category.palette
    a arcm:Category ;
    rdfs:label "Palette mapping"@en ;
    rdfs:comment "colours are relabelled, reduced, expanded or ranked"@en ;
    skos:broader arcm:category.colour ;
    arcm:concerns dul:PhysicalAttribute ;
    skos:closeMatch <http://dbpedia.org/resource/Palette_(computing)> .

arcm:category.shapemap
    a arcm:Category ;
    rdfs:label "Shape-to-output mapping"@en ;
    rdfs:comment "input shapes determine output geometry, often with colour"@en ;
    skos:broader arcm:category.colour ,
        arcm:category.structure ;
    arcm:concerns dul:PhysicalAttribute .

arcm:category.sparse
    a arcm:Category ;
    rdfs:label "Sparse edit on fixed canvas"@en ;
    rdfs:comment "most cells stay; a few are added, erased or recoloured"@en ;
    skos:broader arcm:category.canvas ;
    arcm:concerns dul:Process .

arcm:category.repair
    a arcm:Category ;
    rdfs:label "Repair & symmetry"@en ;
    rdfs:comment "occluded or noisy cells are restored from periodicity or symmetry"@en ;
    skos:broader arcm:category.canvas ;
    arcm:concerns dul:Pattern ;
    skos:related <http://dbpedia.org/resource/Inpainting> ,
        wd:Q1628157 ,
        wd:Q1455736 .

arcm:category.crop
    a arcm:Category ;
    rdfs:label "Crop & extract"@en ;
    rdfs:comment "the output is a sub-region of the input"@en ;
    skos:broader arcm:category.extent ;
    arcm:concerns dul:SpaceRegion ;
    skos:closeMatch <http://dbpedia.org/resource/Cropping_(image)> ,
        wd:Q785116 .

arcm:category.scale
    a arcm:Category ;
    rdfs:label "Scale & tile"@en ;
    rdfs:comment "the output enlarges, repeats or reflects the input"@en ;
    skos:broader arcm:category.extent ,
        arcm:category.layout ;
    arcm:concerns dul:Process ;
    skos:related <http://dbpedia.org/resource/Image_scaling> ,
        wd:Q440296 ,
        <http://dbpedia.org/resource/Tessellation> .

