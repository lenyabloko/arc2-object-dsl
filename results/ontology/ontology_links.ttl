@prefix arcm: <https://github.com/lenyabloko/arc2-object-dsl/ontology/mechanism#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix dbr: <http://dbpedia.org/resource/> .
@prefix om_set1: <http://www.openmath.org/cd/set1#> .
@prefix om_arith1: <http://www.openmath.org/cd/arith1#> .
@prefix om_integer1: <http://www.openmath.org/cd/integer1#> .
@prefix om_integer2: <http://www.openmath.org/cd/integer2#> .
@prefix om_relation1: <http://www.openmath.org/cd/relation1#> .
@prefix om_logic1: <http://www.openmath.org/cd/logic1#> .
@prefix om_setname1: <http://www.openmath.org/cd/setname1#> .
@prefix om_minmax1: <http://www.openmath.org/cd/minmax1#> .
@prefix om_permut1: <http://www.openmath.org/cd/permut1#> .
@prefix om_permutation1: <http://www.openmath.org/cd/permutation1#> .
@prefix om_permgp1: <http://www.openmath.org/cd/permgp1#> .
@prefix om_permgp2: <http://www.openmath.org/cd/permgp2#> .
@prefix om_groupname1: <http://www.openmath.org/cd/groupname1#> .
@prefix om_plangeo1: <http://www.openmath.org/cd/plangeo1#> .
@prefix om_plangeo2: <http://www.openmath.org/cd/plangeo2#> .
@prefix om_plangeo3: <http://www.openmath.org/cd/plangeo3#> .
@prefix om_graph1: <http://www.openmath.org/cd/graph1#> .

<https://github.com/lenyabloko/arc2-object-dsl/ontology/mechanism> a owl:Ontology ;
    rdfs:label "ARC mechanism and prior ontology - semantic links"@en ;
    dcterms:created "2026-09-28"^^xsd:date ;
    rdfs:comment "Grounds the local ARC ontology layers (effect operators, mechanism subclasses, prior families, task categories) in OpenMath, Wikidata, DBpedia and the DUL / BFO upper-level ontologies. Every external IRI was verified with WebFetch / WebSearch before being recorded (see the verified_by field of ontology_links.json). SKOS mapping properties and the arcm annotation properties are used on OWL classes as annotations."@en .

# ---------------------------------------------------------------- vocabulary
arcm:Operator a owl:Class ; rdfs:label "effect operator"@en ; rdfs:comment "A class of grid-to-grid transformations named by its effect (RECOLOUR, MOVE, ...)."@en ;
    rdfs:subClassOf dul:Process .
arcm:Mechanism a owl:Class ; rdfs:label "mechanism"@en ; rdfs:comment "A mechanism subclass of an effect operator (a generic primitive with parameters)."@en ;
    rdfs:subClassOf arcm:Operator .
arcm:Prior a owl:Class ; rdfs:label "prior"@en ; rdfs:comment "A prior: a domain theory (topology, geometry, ...) or one of its parametric program families."@en ;
    rdfs:subClassOf dul:Description .
arcm:Principle a owl:Class ; rdfs:label "physical principle"@en ; rdfs:comment "A physics principle or law used to ground mechanisms and priors."@en ;
    rdfs:subClassOf dul:Theory .
arcm:Analogy a owl:Class ; rdfs:label "common-sense analogy"@en ; rdfs:comment "A common-sense concept (artifact, phenomenon, game) used as an analogy."@en ;
    rdfs:subClassOf dul:Concept .
arcm:MathConcept a owl:Class ; rdfs:label "mathematical concept"@en ; rdfs:comment "A mathematical or computational concept used to ground mechanisms and priors."@en ;
    rdfs:subClassOf dul:FormalEntity .
arcm:Category a owl:Class ; rdfs:label "task category"@en ; rdfs:comment "A meta-class of tasks from categories.json."@en ;
    rdfs:subClassOf dul:Concept .
arcm:groundedIn a owl:AnnotationProperty ; rdfs:label "grounded in"@en ; rdfs:comment "Links a mechanism or prior to a principle, analogy or mathematical concept that it instantiates or is explained by."@en .
arcm:domain a owl:AnnotationProperty ; rdfs:label "prior domain"@en ; rdfs:comment "topology | geometry | combinatorics | optics | mechanics | fluids | action | arithmetic"@en .
arcm:partOfPrior a owl:AnnotationProperty ; rdfs:label "part of prior"@en ; rdfs:comment "Links a prior family (or planned aspect) to its domain prior."@en .
arcm:familyName a owl:AnnotationProperty ; rdfs:label "family name"@en ; rdfs:comment "Program-name prefix yielded by the prior family (e.g. topo:fill)."@en .
arcm:status a owl:AnnotationProperty ; rdfs:label "status"@en ; rdfs:comment "Implementation status of a prior at linking time."@en .
arcm:sourceFile a owl:AnnotationProperty ; rdfs:label "source file"@en ; rdfs:comment "Local file that defines the node."@en .
arcm:concerns a owl:AnnotationProperty ; rdfs:label "concerns"@en ; rdfs:comment "Upper-level (DUL / BFO) kind of entity a task category is about."@en .
arcm:taskCount a owl:AnnotationProperty ; rdfs:label "task count"@en ; rdfs:comment "Number of tasks assigned to a mechanism in mechanism_ontology.json."@en .
arcm:residual a owl:AnnotationProperty ; rdfs:label "residual"@en ; rdfs:comment "True for residual / bookkeeping bins that have no generic primitive."@en .

# ---------------------------------------------------------------- effect operators (rdfs:subClassOf arcm:Operator; upper alignment dul:Process)
arcm:RECOLOUR
    a owl:Class ;
    rdfs:subClassOf arcm:Operator ,
        dul:Process ;
    rdfs:label "RECOLOUR"@en ;
    rdfs:comment "Effect operator (13 mechanism subclasses)."@en ;
    skos:related <http://dbpedia.org/resource/Palette_(computing)> ,
        wd:Q7127464 .

arcm:FILL
    a owl:Class ;
    rdfs:subClassOf arcm:Operator ,
        dul:Process ;
    rdfs:label "FILL"@en ;
    rdfs:comment "Effect operator (5 mechanism subclasses)."@en ;
    skos:related <http://dbpedia.org/resource/Flood_fill> ,
        wd:Q1196156 .

arcm:COMBINE
    a owl:Class ;
    rdfs:subClassOf arcm:Operator ,
        dul:Process ;
    rdfs:label "COMBINE"@en ;
    rdfs:comment "Effect operator (4 mechanism subclasses)."@en ;
    skos:related <http://dbpedia.org/resource/Digital_compositing> ,
        wd:Q3286562 .

arcm:CA
    a owl:Class ;
    rdfs:subClassOf arcm:Operator ,
        dul:Process ;
    rdfs:label "CA"@en ;
    rdfs:comment "Effect operator (2 mechanism subclasses)."@en ;
    skos:closeMatch <http://dbpedia.org/resource/Cellular_automaton> ,
        wd:Q189156 .

arcm:RAY
    a owl:Class ;
    rdfs:subClassOf arcm:Operator ,
        dul:Process ;
    rdfs:label "RAY"@en ;
    rdfs:comment "Effect operator (8 mechanism subclasses)."@en ;
    skos:related <http://dbpedia.org/resource/Ray_(optics)> ,
        wd:Q633620 .

arcm:STAMP
    a owl:Class ;
    rdfs:subClassOf arcm:Operator ,
        dul:Process ;
    rdfs:label "STAMP"@en ;
    rdfs:comment "Effect operator (11 mechanism subclasses)."@en ;
    skos:related <http://dbpedia.org/resource/Rubber_stamp> ,
        wd:Q644099 .

arcm:MOVE
    a owl:Class ;
    rdfs:subClassOf arcm:Operator ,
        dul:Process ;
    rdfs:label "MOVE"@en ;
    rdfs:comment "Effect operator (7 mechanism subclasses)."@en ;
    skos:closeMatch <http://dbpedia.org/resource/Translation_(geometry)> ,
        wd:Q211459 .

arcm:SUMMARISE
    a owl:Class ;
    rdfs:subClassOf arcm:Operator ,
        dul:Process ;
    rdfs:label "SUMMARISE"@en ;
    rdfs:comment "Effect operator (8 mechanism subclasses)."@en .

arcm:SEGMENT
    a owl:Class ;
    rdfs:subClassOf arcm:Operator ,
        dul:Process ;
    rdfs:label "SEGMENT"@en ;
    rdfs:comment "Effect operator (3 mechanism subclasses)."@en ;
    skos:closeMatch <http://dbpedia.org/resource/Image_segmentation> ,
        wd:Q56933 .

arcm:UNKNOWN
    a owl:Class ;
    rdfs:subClassOf arcm:Operator ,
        dul:Process ;
    rdfs:label "UNKNOWN"@en ;
    rdfs:comment "Bookkeeping operator: tasks whose effect class is unknown."@en .

arcm:TILE
    a owl:Class ;
    rdfs:subClassOf arcm:Operator ,
        dul:Process ;
    rdfs:label "TILE"@en ;
    rdfs:comment "Effect operator (3 mechanism subclasses)."@en ;
    skos:related <http://dbpedia.org/resource/Tessellation> ,
        wd:Q214856 .

arcm:COMPLETE
    a owl:Class ;
    rdfs:subClassOf arcm:Operator ,
        dul:Process ;
    rdfs:label "COMPLETE"@en ;
    rdfs:comment "Effect operator (7 mechanism subclasses)."@en ;
    skos:closeMatch <http://dbpedia.org/resource/Inpainting> ,
        wd:Q1628157 .

arcm:TRANSFORM
    a owl:Class ;
    rdfs:subClassOf arcm:Operator ,
        dul:Process ;
    rdfs:label "TRANSFORM"@en ;
    rdfs:comment "Effect operator (8 mechanism subclasses)."@en ;
    skos:closeMatch <http://dbpedia.org/resource/Geometric_transformation> ,
        wd:Q1196371 .

arcm:EXTEND
    a owl:Class ;
    rdfs:subClassOf arcm:Operator ,
        dul:Process ;
    rdfs:label "EXTEND"@en ;
    rdfs:comment "Effect operator (8 mechanism subclasses)."@en ;
    skos:related <http://dbpedia.org/resource/Extrapolation> ,
        wd:Q744069 .

arcm:OTHER
    a owl:Class ;
    rdfs:subClassOf arcm:Operator ,
        dul:Process ;
    rdfs:label "OTHER"@en ;
    rdfs:comment "Bookkeeping operator: tasks reassigned to other effect classes."@en .

arcm:PATH
    a owl:Class ;
    rdfs:subClassOf arcm:Operator ,
        dul:Process ;
    rdfs:label "PATH"@en ;
    rdfs:comment "Effect operator (4 mechanism subclasses)."@en ;
    skos:related <http://dbpedia.org/resource/Pathfinding> ,
        wd:Q1969601 .

arcm:SELECT
    a owl:Class ;
    rdfs:subClassOf arcm:Operator ,
        dul:Process ;
    rdfs:label "SELECT"@en ;
    rdfs:comment "Effect operator (2 mechanism subclasses)."@en ;
    skos:related <http://dbpedia.org/resource/Filter_(higher-order_function)> ,
        om_set1:suchthat .

arcm:PROJECT
    a owl:Class ;
    rdfs:subClassOf arcm:Operator ,
        dul:Process ;
    rdfs:label "PROJECT"@en ;
    rdfs:comment "Effect operator (3 mechanism subclasses)."@en ;
    skos:related <http://dbpedia.org/resource/Parallel_projection> ,
        wd:Q2112445 .

arcm:CONNECT
    a owl:Class ;
    rdfs:subClassOf arcm:Operator ,
        dul:Process ;
    rdfs:label "CONNECT"@en ;
    rdfs:comment "Effect operator (3 mechanism subclasses)."@en ;
    skos:related <http://dbpedia.org/resource/Line_segment> ,
        wd:Q166154 .

arcm:CROP
    a owl:Class ;
    rdfs:subClassOf arcm:Operator ,
        dul:Process ;
    rdfs:label "CROP"@en ;
    rdfs:comment "Effect operator (8 mechanism subclasses)."@en ;
    skos:closeMatch <http://dbpedia.org/resource/Cropping_(image)> ,
        wd:Q785116 .

arcm:SORT
    a owl:Class ;
    rdfs:subClassOf arcm:Operator ,
        dul:Process ;
    rdfs:label "SORT"@en ;
    rdfs:comment "Effect operator (4 mechanism subclasses)."@en ;
    skos:closeMatch <http://dbpedia.org/resource/Sorting> ,
        wd:Q2303697 .

arcm:COUNT
    a owl:Class ;
    rdfs:subClassOf arcm:Operator ,
        dul:Process ;
    rdfs:label "COUNT"@en ;
    rdfs:comment "Effect operator (1 mechanism subclasses)."@en ;
    skos:closeMatch <http://dbpedia.org/resource/Counting> ,
        wd:Q247154 ;
    skos:related om_set1:size .

# ---------------------------------------------------------------- mechanism subclasses (rdfs:subClassOf their operator; upper alignment dul:Process)
arcm:recolour.by_colour_map
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:RECOLOUR ,
        dul:Process ;
    rdfs:label "recolour.by_colour_map"@en ;
    skos:definition "Output = input with a cellwise colour substitution phi (bijection or many-to-one) applied to every cell (optionally outside a key region, optionally after cropping to the main object); phi is either constant across pairs or read from in-grid legend pairs."@en ;
    arcm:taskCount 7 ;
    arcm:groundedIn arcm:math.map ,
        arcm:analogy.palette_swap ,
        arcm:analogy.legend .

arcm:recolour.by_key_position
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:RECOLOUR ,
        dul:Process ;
    rdfs:label "recolour.by_key_position"@en ;
    skos:definition "Targets (objects, rows, columns, quadrants, rank-ordered segments) are recoloured with the colour of the key cell at the corresponding position of a small in-grid key (key column/row, minimap, corner cells, ordered legend stripes); key optionally erased and output optionally cropped to the target area."@en ;
    arcm:taskCount 9 ;
    arcm:groundedIn arcm:analogy.legend ,
        arcm:math.lookup_table .

arcm:recolour.by_shape_match
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:RECOLOUR ,
        dul:Process ;
    rdfs:label "recolour.by_shape_match"@en ;
    skos:definition "Each candidate object (uniform colour) whose shape equals an exemplar/key shape (up to translation, dihedral transform, optionally scale) is recoloured to that exemplar colour; unmatched candidates unchanged."@en ;
    arcm:taskCount 5 ;
    arcm:groundedIn arcm:math.congruence ,
        arcm:math.similarity ,
        arcm:math.dihedral_group ,
        arcm:math.template_matching .

arcm:recolour.by_touching_marker
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:RECOLOUR ,
        dul:Process ;
    rdfs:label "recolour.by_touching_marker"@en ;
    skos:definition "Each target object/region/cell takes the colour of the marker associated with it (marker inside it, touching it, nearest to it, containing ancestor, or paired panel); markers optionally erased."@en ;
    arcm:taskCount 8 ;
    arcm:groundedIn arcm:math.voronoi ,
        arcm:math.containment_tree .

arcm:recolour.object_by_property
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:RECOLOUR ,
        dul:Process ;
    rdfs:label "recolour.object_by_property"@en ;
    skos:definition "Each foreground object (component, row or panel) is recoloured by a table g(feature), feature from {size, size rank, shape/topology class, contains pattern, count of a colour, marker column}; objects not selected keep colour."@en ;
    arcm:taskCount 7 ;
    arcm:groundedIn arcm:math.lookup_table ,
        arcm:math.connected_component .

arcm:recolour.by_ordinal_index
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:RECOLOUR ,
        dul:Process ;
    rdfs:label "recolour.by_ordinal_index"@en ;
    skos:definition "Elements (columns, cells in scan order, objects, runs of rows, regions, cells along a line) are ordered along an axis; element with index i gets palette[i mod k] (or palette[i] for rank) where palette is induced."@en ;
    arcm:taskCount 8 ;
    arcm:groundedIn arcm:math.ranking ,
        arcm:math.modulo .

arcm:recolour.by_distance_layers
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:RECOLOUR ,
        dul:Process ;
    rdfs:label "recolour.by_distance_layers"@en ;
    skos:definition "Cell colour = palette[d mod k] (or palette[d]) where d is a distance of the cell from a source set (object boundary depth, seed cell, frame) under a metric (Chebyshev/Manhattan/geodesic in region); palette constant, from key, or reversed input layer colours."@en ;
    arcm:taskCount 10 ;
    arcm:groundedIn arcm:math.distance_transform ,
        arcm:math.chebyshev_metric ,
        arcm:math.taxicab_metric ,
        arcm:math.modulo .

arcm:recolour.by_region_position
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:RECOLOUR ,
        dul:Process ;
    rdfs:label "recolour.by_region_position"@en ;
    skos:definition "Each container (object, panel, frame interior, lattice cell, whole grid) is split into position classes (halves, quadrants, 3x3 cells, border ring vs interior, corners vs edges); each class painted with a colour from a table (constant or from corner markers)."@en ;
    arcm:taskCount 10 ;
    arcm:groundedIn arcm:math.boundary ,
        arcm:math.midpoint .

arcm:recolour.along_ray
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:RECOLOUR ,
        dul:Process ;
    rdfs:label "recolour.along_ray"@en ;
    skos:definition "Straight lines are cast from source cells/objects (edge markers, odd block, endpoint pair) in induced directions; cells on the line are painted line colour and crossed objects/cells recoloured by rule (to line colour, bg, alt colour, or underlying region colour)."@en ;
    arcm:taskCount 6 ;
    arcm:groundedIn arcm:principle.geometrical_optics ,
        arcm:math.ray .

arcm:recolour.template_sites
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:RECOLOUR ,
        dul:Process ;
    rdfs:label "recolour.template_sites"@en ;
    skos:definition "Find every placement of a template (all-bg window of fixed shape, or a mixed-colour pattern with wildcards) and paint the union of placements (only its bg/target cells) with paint."@en ;
    arcm:taskCount 6 ;
    arcm:groundedIn arcm:math.template_matching ,
        arcm:math.set_union .

arcm:fill.largest_empty
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:FILL ,
        dul:Process ;
    rdfs:label "fill.largest_empty"@en ;
    skos:definition "Find the maximal empty (bg-only) shape of a family (axis rectangle, band, diagonal run) and paint it (optionally shrunk by 1)."@en ;
    arcm:taskCount 4 ;
    arcm:groundedIn arcm:math.largest_empty_rectangle ,
        arcm:math.extremum .

arcm:recolour.cyclic_shift
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:RECOLOUR ,
        dul:Process ;
    rdfs:label "recolour.cyclic_shift"@en ;
    skos:definition "Colour-bearing regions are ordered cyclically (clockwise around core, along loop, left-to-right bands) and each takes the colour of its successor."@en ;
    arcm:taskCount 3 ;
    arcm:groundedIn arcm:math.circular_shift ,
        arcm:math.permutation .

arcm:recolour.by_tiling
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:RECOLOUR ,
        dul:Process ;
    rdfs:label "recolour.by_tiling"@en ;
    skos:definition "Decompose a monochrome shape exactly into pieces from a fixed set (2x2 squares, bars, L-trominoes) and colour each piece by its type/orientation."@en ;
    arcm:taskCount 2 ;
    arcm:groundedIn arcm:math.polyomino ,
        arcm:math.exact_cover ,
        arcm:math.tessellation .

arcm:fill.bbox_bg
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:FILL ,
        dul:Process ;
    rdfs:label "fill.bbox_bg"@en ;
    skos:definition "For each object (component, cluster, or group of 4 corner markers, or cells of colour A), fill cells of target colour (default bg) inside its bbox (margin m, strict interior optional) with paint (constant or legend-mapped from object colour)."@en ;
    arcm:taskCount 7 ;
    arcm:groundedIn arcm:math.bounding_box .

arcm:fill.between_pair_on_line
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:FILL ,
        dul:Process ;
    rdfs:label "fill.between_pair_on_line"@en ;
    skos:definition "Per row and/or column, bg cells between two consecutive fg cells (optionally facing blocks, overlap span inset, only fully-bg spans, min span) are painted."@en ;
    arcm:taskCount 7 ;
    arcm:groundedIn arcm:math.line_segment ,
        arcm:math.collinearity .

arcm:fill.region_by_property
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:FILL ,
        dul:Process ;
    rdfs:label "fill.region_by_property"@en ;
    skos:definition "Segment bg into regions separated by walls; paint each region by a rule on a region feature: enclosed vs border-touching, area rank, rectangularity, size parity, colour of seed inside/adjacent, majority marker colour inside/on boundary."@en ;
    arcm:taskCount 15 ;
    arcm:groundedIn arcm:math.flood_fill ,
        arcm:math.jordan_curve_theorem ,
        arcm:math.connected_component ,
        arcm:analogy.container .

arcm:combine.boolean_panels
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:COMBINE ,
        dul:Process ;
    rdfs:label "combine.boolean_panels"@en ;
    skos:definition "Split into two panels (halves, separator, or grid vs its mirror); output cell colour = truth table T(a_fg, b_fg) over the two fg masks, colours induced."@en ;
    arcm:taskCount 10 ;
    arcm:groundedIn arcm:math.truth_table ,
        arcm:math.set_union ,
        arcm:math.set_intersection ,
        arcm:math.set_difference ,
        arcm:math.symmetric_difference ,
        arcm:math.conjunction ,
        arcm:math.disjunction ,
        arcm:math.exclusive_or ,
        arcm:math.negation .

arcm:combine.priority_overlay
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:COMBINE ,
        dul:Process ;
    rdfs:label "combine.priority_overlay"@en ;
    skos:definition "Split into k equal panels / overlapping windows; output cell = the non-bg value of highest priority (priority by colour order or panel order, induced)."@en ;
    arcm:taskCount 7 ;
    arcm:groundedIn arcm:math.painters_algorithm ,
        arcm:math.z_order ,
        arcm:analogy.occlusion .

arcm:ca.local_rule
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:CA ,
        dul:Process ;
    rdfs:label "ca.local_rule"@en ;
    skos:definition "Output cell = f(input neighbourhood of radius r), f a learned lookup (e.g. bg with diagonal fg neighbour -> paint, convex/concave loop corner -> colour); optionally applied after tiling."@en ;
    arcm:taskCount 4 ;
    arcm:groundedIn arcm:math.cellular_automaton ,
        arcm:math.lookup_table .

arcm:ca.row_recurrence
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:CA ,
        dul:Process ;
    rdfs:label "ca.row_recurrence"@en ;
    skos:definition "Starting from seed rows, each subsequent row (step s) is computed from the previous row(s) by a local rule over diagonal/vertical neighbours; colours optionally alternate by level."@en ;
    arcm:taskCount 2 ;
    arcm:groundedIn arcm:math.elementary_ca ,
        arcm:math.recurrence_relation .

arcm:ray.bounce
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:RAY ,
        dul:Process ;
    rdfs:label "ray.bounce"@en ;
    skos:definition "A ray/path starts at a seed and travels diagonally or in zigzag, reflecting off grid edges or mirror-colour lines, passing through passable lines, until exiting."@en ;
    arcm:taskCount 3 ;
    arcm:groundedIn arcm:principle.specular_reflection ,
        arcm:math.dynamical_billiards ,
        arcm:analogy.mirror .

arcm:stamp.reflect_recoloured
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:STAMP ,
        dul:Process ;
    rdfs:label "stamp.reflect_recoloured"@en ;
    skos:definition "Reflect an object across an axis (separator line, object edge marked by markers, or towards a marker dot) and paint the copy (and/or original) with a recolouring induced from markers."@en ;
    arcm:taskCount 6 ;
    arcm:groundedIn arcm:math.reflection ,
        arcm:analogy.mirror .

arcm:move.translate_recolour
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:MOVE ,
        dul:Process ;
    rdfs:label "move.translate_recolour"@en ;
    skos:definition "All foreground translated by a constant vector and recoloured by a colour map."@en ;
    arcm:taskCount 2 ;
    arcm:groundedIn arcm:math.translation ,
        arcm:math.map .

arcm:summarise.class_to_constant
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:SUMMARISE ,
        dul:Process ;
    rdfs:label "summarise.class_to_constant"@en ;
    skos:definition "Classify the input (dominant colour, binary shape mask) and output a fixed glyph from a table indexed by the class."@en ;
    arcm:taskCount 3 ;
    arcm:groundedIn arcm:math.lookup_table .

arcm:segment.filter_objects
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:SEGMENT ,
        dul:Process ;
    rdfs:label "segment.filter_objects"@en ;
    skos:definition "Delete objects failing a predicate on a count of a marker colour inside them (e.g. keep count<=1, remove argmin)."@en ;
    arcm:taskCount 2 ;
    arcm:groundedIn arcm:math.filter ,
        arcm:math.counting .

arcm:segment.pack_pieces
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:SEGMENT ,
        dul:Process ;
    rdfs:label "segment.pack_pieces"@en ;
    skos:definition "Translate (and possibly rotate) the pieces so that they tile a fixed-size rectangle/frame exactly."@en ;
    arcm:taskCount 3 ;
    arcm:groundedIn arcm:math.exact_cover ,
        arcm:math.polyomino ,
        arcm:analogy.jigsaw_puzzle ,
        arcm:principle.conservation_law .

arcm:recolour.residual
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:RECOLOUR ,
        dul:Process ;
    rdfs:label "recolour.residual"@en ;
    skos:definition "No generic primitive; see reasons"@en ;
    arcm:taskCount 37 ;
    arcm:residual true .

arcm:fill.residual
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:FILL ,
        dul:Process ;
    rdfs:label "fill.residual"@en ;
    skos:definition "No generic primitive; see reasons"@en ;
    arcm:taskCount 20 ;
    arcm:residual true .

arcm:segment.residual
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:SEGMENT ,
        dul:Process ;
    rdfs:label "segment.residual"@en ;
    skos:definition "No generic primitive; see reasons"@en ;
    arcm:taskCount 21 ;
    arcm:residual true .

arcm:combine.residual
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:COMBINE ,
        dul:Process ;
    rdfs:label "combine.residual"@en ;
    skos:definition "No generic primitive; see reasons"@en ;
    arcm:taskCount 5 ;
    arcm:residual true .

arcm:unknown.residual
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:UNKNOWN ,
        dul:Process ;
    rdfs:label "unknown.residual"@en ;
    skos:definition "No generic primitive; see reasons"@en ;
    arcm:taskCount 3 ;
    arcm:residual true .

arcm:stamp.template_at_markers
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:STAMP ,
        dul:Process ;
    rdfs:label "stamp.template_at_markers"@en ;
    skos:definition "One multi-cell template object exists in the input; every marker (lone cell or small cluster not part of the template) receives a translated copy of the template, positioned by an anchor rule; the copy may be recoloured to the marker colour or transformed by a per-anchor-colour dihedral; original template/markers optionally erased; output may be the grid or the concatenation of copies."@en ;
    arcm:taskCount 9 ;
    arcm:groundedIn arcm:analogy.rubber_stamp ,
        arcm:math.translation .

arcm:stamp.complete_partial_matches
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:STAMP ,
        dul:Process ;
    rdfs:label "stamp.complete_partial_matches"@en ;
    skos:definition "A complete reference template (a multicolour object, or a patch plus its frame) is present; every other object/configuration that equals a subset of the template under an allowed transform group G (dihedral) and scale s is completed by painting the missing template cells in place (colours from template, or a fixed paint colour)."@en ;
    arcm:taskCount 15 ;
    arcm:groundedIn arcm:math.template_matching ,
        arcm:math.similarity ,
        arcm:math.dihedral_group ,
        arcm:analogy.amodal_completion .

arcm:stamp.copy_to_congruent_target
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:STAMP ,
        dul:Process ;
    rdfs:label "stamp.copy_to_congruent_target"@en ;
    skos:definition "A source object carries a pattern; target regions have the same outline/size as the source (silhouette of placeholder colour, same-colour plain rect, same-size frame, or empty bg hole) and receive the source pattern (optionally mirrored, 9-slice resized, or recoloured to the target frame colour); unmatched targets or the source may be erased."@en ;
    arcm:taskCount 7 ;
    arcm:groundedIn arcm:math.congruence ,
        arcm:math.template_matching .

arcm:stamp.panel_copy
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:STAMP ,
        dul:Process ;
    rdfs:label "stamp.panel_copy"@en ;
    skos:definition "Grid is partitioned into panels by separator lines; the content of the source panel(s) is copied into target panels chosen by a rule (all, marked, same frame colour, parity lattice, pattern continuation) with an optional per-target transform (rotation by index) or recolour (separator colour)."@en ;
    arcm:taskCount 7 ;
    arcm:groundedIn arcm:math.translation ,
        arcm:analogy.rubber_stamp .

arcm:stamp.local_stencil
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:STAMP ,
        dul:Process ;
    rdfs:label "stamp.local_stencil"@en ;
    skos:definition "Each seed (single cell, 2x2 block, or small object matched by a local pattern) gets a fixed relative stencil of cells painted around it; stencil offsets/colours are a function of the seed's colour (or taken from the seed's own cells), optionally gated by context (inside region, nearest border colour) and optionally erasing the seed."@en ;
    arcm:taskCount 12 ;
    arcm:groundedIn arcm:analogy.stencil ,
        arcm:math.dilation .

arcm:stamp.stencil_at_computed_point
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:STAMP ,
        dul:Process ;
    rdfs:label "stamp.stencil_at_computed_point"@en ;
    skos:definition "A fixed stencil (plus, 3x3 ring, cross of marker colours) is painted at a point computed from markers: midpoint of two markers, centroid of three markers, or intersection of a horizontal and vertical line."@en ;
    arcm:taskCount 3 ;
    arcm:groundedIn arcm:analogy.stencil ,
        arcm:math.midpoint ,
        arcm:math.centroid ,
        arcm:math.line_intersection .

arcm:stamp.grow_ring
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:STAMP ,
        dul:Process ;
    rdfs:label "stamp.grow_ring"@en ;
    skos:definition "Around each object (or seed) paint a metric ball/ring (Chebyshev square or Manhattan diamond) of thickness/radius r computed from an object property (inner-core size, count of inner dots, distance to nearest obstacle minus 1, half segment length), colour from a role, painting only background."@en ;
    arcm:taskCount 5 ;
    arcm:groundedIn arcm:math.dilation ,
        arcm:math.chebyshev_metric ,
        arcm:math.taxicab_metric .

arcm:stamp.bbox_outline
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:STAMP ,
        dul:Process ;
    rdfs:label "stamp.bbox_outline"@en ;
    skos:definition "Draw a 1-cell rectangle outline defined by the bbox of selected cells (markers, all cells of a colour, or the whole grid), optionally inset/outset by d, in a paint colour; optionally erase everything else / the seed."@en ;
    arcm:taskCount 5 ;
    arcm:groundedIn arcm:math.bounding_box ,
        arcm:math.boundary .

arcm:stamp.count_bar
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:STAMP ,
        dul:Process ;
    rdfs:label "stamp.count_bar"@en ;
    skos:definition "Draw one straight bar per counted item whose length equals an induced count (cells per colour, distinct colours in a block, difference of two colour counts), placed at a slot relative to the item (next slot, below block, beside key entry, histogram column)."@en ;
    arcm:taskCount 4 ;
    arcm:groundedIn arcm:math.counting ,
        arcm:analogy.bar_chart ,
        arcm:math.histogram ,
        arcm:math.subtraction .

arcm:stamp.residual
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:STAMP ,
        dul:Process ;
    rdfs:label "stamp.residual"@en ;
    skos:definition "Tasks whose STAMP step is embedded in a task-specific pipeline (rays, moves, summaries) or uses a bespoke template."@en ;
    arcm:taskCount 19 ;
    arcm:residual true .

arcm:tile.block_placement
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:TILE ,
        dul:Process ;
    rdfs:label "tile.block_placement"@en ;
    skos:definition "Output is a block lattice of input-sized (or template-sized) blocks; block (i,j) holds template X (input, colour-swapped input, fixed 2x2 checker, downscaled template) iff mask(i,j), where mask = X==fg, X==bg, uniform row/col index, or first k blocks in reading order (k=count)."@en ;
    arcm:taskCount 7 ;
    arcm:groundedIn arcm:math.kronecker_product ,
        arcm:math.tessellation .

arcm:tile.arrangement
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:TILE ,
        dul:Process ;
    rdfs:label "tile.arrangement"@en ;
    skos:definition "Output = fixed arrangement of transformed copies of the input (or its cropped object): n×m repeat, rotations around centre, frame+stack; then an optional learned local post-rule (stencil/column projection) applied on the tiled canvas."@en ;
    arcm:taskCount 5 ;
    arcm:groundedIn arcm:math.tessellation ,
        arcm:math.dihedral_group ,
        arcm:math.translation .

arcm:tile.residual
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:TILE ,
        dul:Process ;
    rdfs:label "tile.residual"@en ;
    skos:definition "Bespoke motif propagation."@en ;
    arcm:taskCount 2 ;
    arcm:residual true .

arcm:complete.symmetry_global
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:COMPLETE ,
        dul:Process ;
    rdfs:label "complete.symmetry_global"@en ;
    skos:definition "Whole grid (or the single motif around a centre anchor/separator axes) is symmetric under an inferred group (mirror H/V, rot90, rot180, D4) about an inferred centre; missing or occluder-coloured cells are filled from their orbit (optionally in a paint colour)."@en ;
    arcm:taskCount 9 ;
    arcm:groundedIn arcm:math.symmetry_group ,
        arcm:math.dihedral_group ,
        arcm:math.orbit ,
        arcm:math.reflection_symmetry ,
        arcm:math.rotational_symmetry ,
        arcm:analogy.kaleidoscope ,
        arcm:math.inpainting .

arcm:complete.symmetry_per_object
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:COMPLETE ,
        dul:Process ;
    rdfs:label "complete.symmetry_per_object"@en ;
    skos:definition "Same as symmetry_global but applied independently inside each object/frame: axis from an in-object line, frame notches, or best-fit; noise outside frames/occluder erased."@en ;
    arcm:taskCount 5 ;
    arcm:groundedIn arcm:math.reflection_symmetry ,
        arcm:math.dihedral_group ,
        arcm:math.orbit .

arcm:complete.period
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:COMPLETE ,
        dul:Process ;
    rdfs:label "complete.period"@en ;
    skos:definition "Grid (or lattice of sites) follows a 2D period (possibly diagonal); cells masked by holes/occluders or missing lattice sites are restored from the period (missing sites optionally painted a new colour or marked)."@en ;
    arcm:taskCount 5 ;
    arcm:groundedIn arcm:math.periodicity ,
        arcm:math.lattice ,
        arcm:math.wallpaper_group ,
        arcm:math.inpainting .

arcm:complete.prefix_by_template
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:COMPLETE ,
        dul:Process ;
    rdfs:label "complete.prefix_by_template"@en ;
    skos:definition "Rows/bands are prefixes of a full template row/band; each prefix is extended to full length following the template (through a colour map induced from the prefix, or in a new paint colour)."@en ;
    arcm:taskCount 2 ;
    arcm:groundedIn arcm:math.template_matching ,
        arcm:math.extrapolation .

arcm:complete.rectangle
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:COMPLETE ,
        dul:Process ;
    rdfs:label "complete.rectangle"@en ;
    skos:definition "Objects are solid (possibly overlapping) rectangles corrupted by a noise colour; restore each rectangle and erase noise."@en ;
    arcm:taskCount 1 ;
    arcm:groundedIn arcm:analogy.amodal_completion ,
        arcm:math.noise_reduction ,
        arcm:math.bounding_box .

arcm:complete.residual
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:COMPLETE ,
        dul:Process ;
    rdfs:label "complete.residual"@en ;
    skos:definition "Constraint-style or bespoke completions (latin square, colour-set, panel merge, move+occlusion, dashed-line gaps)."@en ;
    arcm:taskCount 6 ;
    arcm:residual true .

arcm:move.slide_until_contact
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:MOVE ,
        dul:Process ;
    rdfs:label "move.slide_until_contact"@en ;
    skos:definition "Every mover object (connected component, rigid) is translated along one axis direction until it touches a non-background cell or the grid edge; direction is a global constant or a lookup keyed by an object property (colour, shape class, containing region). Movers processed nearest-to-destination first so they stack. Optional: paint swept cells, recolour by class."@en ;
    arcm:taskCount 14 ;
    arcm:groundedIn arcm:principle.gravity ,
        arcm:principle.inertia ,
        arcm:principle.mechanical_equilibrium ,
        arcm:math.rigid_transformation ,
        arcm:analogy.tetris .

arcm:move.toward_anchor
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:MOVE ,
        dul:Process ;
    rdfs:label "move.toward_anchor"@en ;
    skos:definition "Each mover (cell or object) moves straight toward the anchor it is paired with (same colour border/line/block, or nearest aligned anchor) until adjacent to it; unpaired/unaligned movers are erased or kept by an induced flag."@en ;
    arcm:taskCount 10 ;
    arcm:groundedIn arcm:math.translation ,
        arcm:principle.gravity .

arcm:move.by_vector
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:MOVE ,
        dul:Process ;
    rdfs:label "move.by_vector"@en ;
    skos:definition "Each object is translated by a vector computed from its own properties or a global count: v = k * unit_dir where k in {1, width, height, size, marker count} or v = map(colour)."@en ;
    arcm:taskCount 12 ;
    arcm:groundedIn arcm:math.translation ,
        arcm:math.multiplication .

arcm:move.to_position
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:MOVE ,
        dul:Process ;
    rdfs:label "move.to_position"@en ;
    skos:definition "Mover is placed so a reference point of it (a key-coloured cell, centre, corner) coincides with a target point defined by an anchor (matching-colour marker cell, lattice-cell centre, opposite frame corner, anchor-block cell in same quadrant); original erased."@en ;
    arcm:taskCount 7 ;
    arcm:groundedIn arcm:math.translation ,
        arcm:math.image_registration .

arcm:move.fit_into_hole
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:MOVE ,
        dul:Process ;
    rdfs:label "move.fit_into_hole"@en ;
    skos:definition "Loose pieces are matched to holes/cavities/gaps/complementary profiles of container objects by shape (optionally rotation) and translated so they exactly fill it; unmatched pieces/noise erased."@en ;
    arcm:taskCount 5 ;
    arcm:groundedIn arcm:analogy.lock_and_key ,
        arcm:analogy.jigsaw_puzzle ,
        arcm:math.congruence ,
        arcm:math.rotation .

arcm:transform.kronecker
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:TRANSFORM ,
        dul:Process ;
    rdfs:label "transform.kronecker"@en ;
    skos:definition "Fractal/Kronecker product: output is an (H*h)x(W*w) grid of blocks; block (i,j) = tile_on(in[i,j]) if pred(in[i,j]) else tile_off, where tile_on is the input itself, the input masked to colour c, or a legend motif for c."@en ;
    arcm:taskCount 8 ;
    arcm:groundedIn arcm:math.kronecker_product ,
        arcm:math.self_similarity .

arcm:transform.tile_dihedral
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:TRANSFORM ,
        dul:Process ;
    rdfs:label "transform.tile_dihedral"@en ;
    skos:definition "Output is an r x c arrangement of dihedral images of a source S (whole input, cropped object, recoloured input, quadrant), possibly with shared-edge overlap; r,c constant or from a count (distinct colours, markers, input side)."@en ;
    arcm:taskCount 9 ;
    arcm:groundedIn arcm:math.dihedral_group ,
        arcm:math.tessellation ,
        arcm:analogy.kaleidoscope .

arcm:transform.scale
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:TRANSFORM ,
        dul:Process ;
    rdfs:label "transform.scale"@en ;
    skos:definition "Output is the source (whole input, fg bbox, inner block, sampled lattice) upscaled by an integer factor k (constant, #distinct colours) or to fit a target frame interior; optional non-uniform per-row/col factors."@en ;
    arcm:taskCount 8 ;
    arcm:groundedIn arcm:math.scaling ,
        arcm:math.image_scaling .

arcm:transform.dihedral
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:TRANSFORM ,
        dul:Process ;
    rdfs:label "transform.dihedral"@en ;
    skos:definition "Output = one dihedral op D applied to a source (whole grid, crop, block-summary, tile-lattice of motifs); D constant or inferred from an in-grid example pair or marker layout."@en ;
    arcm:taskCount 6 ;
    arcm:groundedIn arcm:math.dihedral_group ,
        arcm:math.reflection ,
        arcm:math.rotation .

arcm:transform.row_shift
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:TRANSFORM ,
        dul:Process ;
    rdfs:label "transform.row_shift"@en ;
    skos:definition "Each row (or column) is shifted horizontally by s(r): linear shear relative to an anchor row, periodic sequence, parity, or a constant roll given by a marker offset; cyclic (roll) or with padding/clamp."@en ;
    arcm:taskCount 7 ;
    arcm:groundedIn arcm:math.shear_mapping ,
        arcm:math.circular_shift ,
        arcm:analogy.slot_machine .

arcm:transform.reflect_object
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:TRANSFORM ,
        dul:Process ;
    rdfs:label "transform.reflect_object"@en ;
    skos:definition "An object is reflected across an axis given by a marker/bracket/line/bbox edge (or its own centre); copy is OR-ed with original or replaces it, optionally painted in marker colour."@en ;
    arcm:taskCount 10 ;
    arcm:groundedIn arcm:math.reflection ,
        arcm:analogy.mirror .

arcm:transform.rotate_about_pivot
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:TRANSFORM ,
        dul:Process ;
    rdfs:label "transform.rotate_about_pivot"@en ;
    skos:definition "A segment/offset is rotated by 90 degrees about a pivot cell (anchor, marked pivot, bar base) and repainted; source erased."@en ;
    arcm:taskCount 3 ;
    arcm:groundedIn arcm:math.rotation ,
        arcm:analogy.lever .

arcm:extend.periodic_fill
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:EXTEND ,
        dul:Process ;
    rdfs:label "extend.periodic_fill"@en ;
    skos:definition "A periodic pattern (1D or 2D, possibly diagonal-shifted translation lattice) visible in a known region is continued over the whole canvas (possibly enlarged), overwriting noise/strip/bg cells."@en ;
    arcm:taskCount 12 ;
    arcm:groundedIn arcm:math.periodicity ,
        arcm:math.lattice ,
        arcm:math.wallpaper_group ,
        arcm:math.extrapolation .

arcm:extend.periodic_lines
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:EXTEND ,
        dul:Process ;
    rdfs:label "extend.periodic_lines"@en ;
    skos:definition "Full lines are drawn perpendicular to an axis at positions seed + k*p (p from seed spacing), colours cycling through seed colours/legend; optional caps."@en ;
    arcm:taskCount 4 ;
    arcm:groundedIn arcm:math.arithmetic_progression ,
        arcm:math.periodicity ,
        arcm:math.modulo .

arcm:extend.repeat_stamp
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:EXTEND ,
        dul:Process ;
    rdfs:label "extend.repeat_stamp"@en ;
    skos:definition "A template object is copied repeatedly along a translation vector (from marker/fragment/object dims) until edge or target, each copy optionally recoloured."@en ;
    arcm:taskCount 6 ;
    arcm:groundedIn arcm:math.translation ,
        arcm:math.frieze_group ,
        arcm:analogy.rubber_stamp .

arcm:extend.sequence_positions
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:EXTEND ,
        dul:Process ;
    rdfs:label "extend.sequence_positions"@en ;
    skos:definition "Seed items (cells/rings) are repeated at positions following an arithmetic/triangular sequence inferred from seeds, colours cycling."@en ;
    arcm:taskCount 3 ;
    arcm:groundedIn arcm:math.arithmetic_progression ,
        arcm:math.triangular_number ,
        arcm:math.modulo .

arcm:extend.staircase
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:EXTEND ,
        dul:Process ;
    rdfs:label "extend.staircase"@en ;
    skos:definition "From a seed bar, successive parallel bars at distance k have length L0 + a*k (a per side), colour per side or by parity."@en ;
    arcm:taskCount 4 ;
    arcm:groundedIn arcm:math.arithmetic_progression ,
        arcm:analogy.stairs ,
        arcm:math.parity .

arcm:extend.stretch_to_marker
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:EXTEND ,
        dul:Process ;
    rdfs:label "extend.stretch_to_marker"@en ;
    skos:definition "A framed rectangle is stretched along an axis until it reaches a marker singleton; marker erased, internal structure (frame/dividers) preserved."@en ;
    arcm:taskCount 2 ;
    arcm:groundedIn arcm:math.scaling .

arcm:extend.smear
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:EXTEND ,
        dul:Process ;
    rdfs:label "extend.smear"@en ;
    skos:definition "Each coloured cell in a key line is smeared parallel to a bar / upward until next colour or span end."@en ;
    arcm:taskCount 2 .

arcm:move.residual
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:MOVE ,
        dul:Process ;
    rdfs:label "move.residual"@en ;
    skos:definition "Tasks needing bespoke mechanisms"@en ;
    arcm:taskCount 20 ;
    arcm:residual true .

arcm:transform.residual
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:TRANSFORM ,
        dul:Process ;
    rdfs:label "transform.residual"@en ;
    skos:definition "Tasks needing bespoke mechanisms"@en ;
    arcm:taskCount 15 ;
    arcm:residual true .

arcm:extend.residual
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:EXTEND ,
        dul:Process ;
    rdfs:label "extend.residual"@en ;
    skos:definition "Tasks needing bespoke mechanisms"@en ;
    arcm:taskCount 11 ;
    arcm:residual true .

arcm:reassigned_out
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:OTHER ,
        dul:Process ;
    rdfs:label "reassigned_out"@en ;
    skos:definition "Tasks reassigned to other effect classes"@en ;
    arcm:taskCount 0 ;
    arcm:residual true .

arcm:ray.full_line
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:RAY ,
        dul:Process ;
    rdfs:label "ray.full_line"@en ;
    skos:definition "Each seed (singleton cell, or a designated cell/axis of an object such as a domino's orientation or a block's centre) paints its entire row and/or column (axis chosen per seed colour or object orientation), optionally clipped to an enclosing region (band, cropped rectangle). Crossings resolved by a priority order or painted with a new constant colour; original objects stay on top."@en ;
    arcm:taskCount 9 ;
    arcm:groundedIn arcm:math.line .

arcm:ray.orthogonal_directed
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:RAY ,
        dul:Process ;
    rdfs:label "ray.orthogonal_directed"@en ;
    skos:definition "Each seed cell/object emits an axis-aligned half-ray in a direction given by a rule (fixed per colour, toward/away from an aligned target, toward the nearest edge, pointing out of the object away from its odd cell) and stops at the edge, just before the first non-bg cell, or at contact with the target. Paint = seed colour or role colour, optionally a periodic pattern."@en ;
    arcm:taskCount 12 ;
    arcm:groundedIn arcm:math.ray ,
        arcm:principle.geometrical_optics .

arcm:ray.diagonal_from_object
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:RAY ,
        dul:Process ;
    rdfs:label "ray.diagonal_from_object"@en ;
    skos:definition "Diagonal rays emitted from selected corners of objects (all corners, the missing corner of an L-triomino, closed-side corners of a cup, marker-flagged corners, or a single seed's 4 diagonals) outward to the border or until non-bg, in object/role colour, optionally with beam width = object width and after a canvas rescale."@en ;
    arcm:taskCount 17 ;
    arcm:groundedIn arcm:math.ray ,
        arcm:principle.geometrical_optics .

arcm:ray.periodic_motif
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:RAY ,
        dul:Process ;
    rdfs:label "ray.periodic_motif"@en ;
    skos:definition "A seed emits a trail along a direction in which a fixed short motif (separator/own colour alternation, 2-step staircase, dotted stride) is repeated to the border."@en ;
    arcm:taskCount 3 ;
    arcm:groundedIn arcm:math.ray ,
        arcm:math.periodicity ,
        arcm:math.frieze_group .

arcm:ray.walker_turn_split
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:RAY ,
        dul:Process ;
    rdfs:label "ray.walker_turn_split"@en ;
    skos:definition "A ray from a seed (usually on an edge) travels straight; on hitting an obstacle it reacts by a policy: split perpendicular both ways, turn cw/ccw keyed by obstacle colour, reflect off a wall, or spiral; continues until edge. Paint = seed colour or constant."@en ;
    arcm:taskCount 6 ;
    arcm:groundedIn arcm:principle.specular_reflection ,
        arcm:principle.geometrical_optics ,
        arcm:analogy.beam_splitter .

arcm:path.walker_detour
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:PATH ,
        dul:Process ;
    rdfs:label "path.walker_detour"@en ;
    skos:definition "Rays from seeds advance in a fixed direction; when the next cell is an obstacle they sidestep (fixed side or nearest free) around it and resume the original direction, ending at the border."@en ;
    arcm:taskCount 7 ;
    arcm:groundedIn arcm:math.pathfinding ,
        arcm:principle.fluid_flow .

arcm:ray.container_leak
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:RAY ,
        dul:Process ;
    rdfs:label "ray.container_leak"@en ;
    skos:definition "Hollow container/bracket objects with an opening: interior is filled with a paint colour and a beam of the same colour escapes through the opening (width = opening, optional diagonal flare) to the edge."@en ;
    arcm:taskCount 3 ;
    arcm:groundedIn arcm:analogy.container ,
        arcm:analogy.leak ,
        arcm:principle.fluid_flow .

arcm:select.empty_lines_paint
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:SELECT ,
        dul:Process ;
    rdfs:label "select.empty_lines_paint"@en ;
    skos:definition "Rows/columns that contain no foreground (globally, or within the span of an object / block lattice) are painted with a constant colour (optionally different colours inside vs outside the fg bbox)."@en ;
    arcm:taskCount 3 ;
    arcm:groundedIn arcm:math.empty_set ,
        arcm:math.filter .

arcm:project.and_intersection
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:PROJECT ,
        dul:Process ;
    rdfs:label "project.and_intersection"@en ;
    skos:definition "Markers along a border row and border column (or colour runs of a legend row/column) project across the grid; a cell is painted where a row-projection and column-projection intersect (AND), with the marker colour or a constant, optionally only inside a target rectangle."@en ;
    arcm:taskCount 3 ;
    arcm:groundedIn arcm:math.cartesian_product ,
        arcm:math.conjunction ,
        arcm:math.parallel_projection .

arcm:project.marker_onto_target
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:PROJECT ,
        dul:Process ;
    rdfs:label "project.marker_onto_target"@en ;
    skos:definition "A marker cell is transported along its row/col to a landing position (first cell of target object, cell adjacent to a separator, far edge cell) and only the landing cell is painted (source kept or erased)."@en ;
    arcm:taskCount 4 ;
    arcm:groundedIn arcm:math.parallel_projection ,
        arcm:analogy.shadow .

arcm:connect.aligned_pair
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:CONNECT ,
        dul:Process ;
    rdfs:label "connect.aligned_pair"@en ;
    skos:definition "Pairs of same-colour cells/objects aligned on a row, column or diagonal (nearest facing partner) are joined by a straight segment between their facing tips, painted with a constant or the pair colour."@en ;
    arcm:taskCount 6 ;
    arcm:groundedIn arcm:math.line_segment ,
        arcm:math.collinearity .

arcm:connect.lattice_between
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:CONNECT ,
        dul:Process ;
    rdfs:label "connect.lattice_between"@en ;
    skos:definition "Grid partitioned into a lattice of tiles; tiles with the same mark (colour at same intra-tile position, or matching an exemplar) in the same lattice row/col cause the tiles/gaps between them to be filled with that mark (or new colour; overlap -> mix colour)."@en ;
    arcm:taskCount 7 ;
    arcm:groundedIn arcm:math.collinearity ,
        arcm:math.line_segment .

arcm:path.elbow_route
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:PATH ,
        dul:Process ;
    rdfs:label "path.elbow_route"@en ;
    skos:definition "Draw a route between 2-3 marker cells using a fixed move order (vertical-then-horizontal, horizontal-then-vertical, diagonal-then-straight, king moves), chained across markers; paint new constant or marker colour on bg only."@en ;
    arcm:taskCount 7 ;
    arcm:groundedIn arcm:math.taxicab_metric ,
        arcm:math.pathfinding .

arcm:path.shortest_route
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:PATH ,
        dul:Process ;
    rdfs:label "path.shortest_route"@en ;
    skos:definition "Endpoints (same-colour cells/segments) are joined by a shortest 4-connected path avoiding obstacle cells (or crossing barriers only at their gaps)."@en ;
    arcm:taskCount 3 ;
    arcm:groundedIn arcm:math.shortest_path ,
        arcm:math.taxicab_metric ,
        arcm:principle.least_action ,
        arcm:analogy.maze .

arcm:crop.odd_one_out
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:CROP ,
        dul:Process ;
    rdfs:label "crop.odd_one_out"@en ;
    skos:definition "Segment panels/objects; output the one whose content differs from all others (unique pattern, unique colour, unique (a)symmetry)."@en ;
    arcm:taskCount 7 ;
    arcm:groundedIn arcm:math.odd_one_out .

arcm:crop.by_score
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:CROP ,
        dul:Process ;
    rdfs:label "crop.by_score"@en ;
    skos:definition "Segment objects/frames; select the one maximising/minimising a score (count of marker colour/sub-pattern, size, adjacency to marker, inclusion in guides, content colour = frame colour) and output its bbox or interior."@en ;
    arcm:taskCount 14 ;
    arcm:groundedIn arcm:math.extremum ,
        arcm:math.ranking .

arcm:crop.canonical_window
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:CROP ,
        dul:Process ;
    rdfs:label "crop.canonical_window"@en ;
    skos:definition "Output is a window of the input chosen canonically: a fixed corner window, the top-left quadrant of a symmetric object's bbox (fundamental domain), or one period of a periodic grid."@en ;
    arcm:taskCount 7 ;
    arcm:groundedIn arcm:math.fundamental_domain ,
        arcm:math.periodicity .

arcm:crop.overlay_windows
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:CROP ,
        dul:Process ;
    rdfs:label "crop.overlay_windows"@en ;
    skos:definition "Several equal-size windows/fragments (aligned by frame or by a shared anchor cell) are overlaid with non-base cells winning, output = the overlay."@en ;
    arcm:taskCount 3 ;
    arcm:groundedIn arcm:math.painters_algorithm ,
        arcm:math.set_union .

arcm:crop.fit_by_anchor
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:CROP ,
        dul:Process ;
    rdfs:label "crop.fit_by_anchor"@en ;
    skos:definition "Pieces carrying a marker cell/constellation are translated so that their markers coincide with matching markers in a target panel/canvas; output = the target region."@en ;
    arcm:taskCount 3 ;
    arcm:groundedIn arcm:math.image_registration ,
        arcm:analogy.jigsaw_puzzle .

arcm:crop.fit_by_shape
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:CROP ,
        dul:Process ;
    rdfs:label "crop.fit_by_shape"@en ;
    skos:definition "Host region with holes; each loose piece whose shape (up to dihedral) matches a hole is inserted into it; output = the host bbox."@en ;
    arcm:taskCount 3 ;
    arcm:groundedIn arcm:analogy.lock_and_key ,
        arcm:analogy.jigsaw_puzzle ,
        arcm:math.congruence .

arcm:crop.extract_and_concat
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:CROP ,
        dul:Process ;
    rdfs:label "crop.extract_and_concat"@en ;
    skos:definition "Selected pieces (objects passing a predicate, or strips between paired markers, or panel shapes) are each cropped and concatenated in positional order along the axis of spread (or packed in a 2x2 layout preserving quadrant)."@en ;
    arcm:taskCount 7 ;
    arcm:groundedIn arcm:math.concatenation ,
        arcm:math.filter .

arcm:complete.crop_occluded
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:COMPLETE ,
        dul:Process ;
    rdfs:label "complete.crop_occluded"@en ;
    skos:definition "Input is a symmetric/periodic pattern with a solid occluder rectangle; the occluded content is reconstructed and only the occluder region is output."@en ;
    arcm:taskCount 2 ;
    arcm:groundedIn arcm:math.inpainting ,
        arcm:analogy.occlusion ,
        arcm:analogy.amodal_completion ,
        arcm:math.symmetry_group ,
        arcm:math.periodicity .

arcm:summarise.panel_to_pixel
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:SUMMARISE ,
        dul:Process ;
    rdfs:label "summarise.panel_to_pixel"@en ;
    skos:definition "Grid is split into panels (by separator lines, equal kxk blocks, or solid rectangles in a row/col layout); output has one pixel per panel given by a reduction (majority colour, single non-bg colour, bg colour, predicate->colour)."@en ;
    arcm:taskCount 12 ;
    arcm:groundedIn arcm:math.image_scaling ,
        arcm:math.mode .

arcm:summarise.count_to_glyph
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:SUMMARISE ,
        dul:Process ;
    rdfs:label "summarise.count_to_glyph"@en ;
    skos:definition "Count N of a selected item class (cells, objects, 2x2 squares, empty rows) and render N marks into a fixed canvas following a fixed slot order (reading order, snake, diagonal, bar), in item colour or constant."@en ;
    arcm:taskCount 11 ;
    arcm:groundedIn arcm:math.counting ,
        arcm:analogy.tally_marks ,
        arcm:analogy.boustrophedon .

arcm:summarise.ranked_bars
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:SUMMARISE ,
        dul:Process ;
    rdfs:label "summarise.ranked_bars"@en ;
    skos:definition "Items (colours, objects, lines, bands) are ranked by a key (count, size, position, layering) and rendered as a list of bars/cells: one row/column per item, bar length = its count/size (or 1), aligned to a side."@en ;
    arcm:taskCount 17 ;
    arcm:groundedIn arcm:math.ranking ,
        arcm:math.sorting ,
        arcm:analogy.bar_chart ,
        arcm:math.histogram .

arcm:summarise.concentric_rings
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:SUMMARISE ,
        dul:Process ;
    rdfs:label "summarise.concentric_rings"@en ;
    skos:definition "An ordered list of colours (items ranked by size/count/distance/legend order) is rendered as nested concentric square rings (outer->inner), on a canvas sized by the list or inside a frame/around a seed."@en ;
    arcm:taskCount 11 ;
    arcm:groundedIn arcm:math.ranking ,
        arcm:analogy.matryoshka ,
        arcm:math.chebyshev_metric .

arcm:summarise.select_colour
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:SUMMARISE ,
        dul:Process ;
    rdfs:label "summarise.select_colour"@en ;
    skos:definition "Select one object/colour by a predicate or extremum (has hole, uninterrupted line, most noise, max arm count, max growth) and output a small solid grid (1x1/2x2) of its colour."@en ;
    arcm:taskCount 5 ;
    arcm:groundedIn arcm:math.extremum .

arcm:summarise.lookup_by_feature
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:SUMMARISE ,
        dul:Process ;
    rdfs:label "summarise.lookup_by_feature"@en ;
    skos:definition "Output (whole grid or per-panel pixel) is taken from a table learned from train keyed by a discrete feature of the input (symmetry predicate, connectivity, count of distinct colours, shape class/hole pattern)."@en ;
    arcm:taskCount 5 ;
    arcm:groundedIn arcm:math.lookup_table .

arcm:sort.rank_and_pack
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:SORT ,
        dul:Process ;
    rdfs:label "sort.rank_and_pack"@en ;
    skos:definition "Items (objects, bars, cells, panels) are sorted by a key (size, length, column, count) and placed into a sequence of slots (along an edge bottom-aligned, stacked on a floor, snake order in a small canvas, nested at a corner)."@en ;
    arcm:taskCount 5 ;
    arcm:groundedIn arcm:math.sorting ,
        arcm:math.ranking ,
        arcm:principle.gravity ,
        arcm:analogy.stack ,
        arcm:analogy.boustrophedon .

arcm:sort.permute_attribute_sequence
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:SORT ,
        dul:Process ;
    rdfs:label "sort.permute_attribute_sequence"@en ;
    skos:definition "Items ordered along an axis/path keep their geometry while one attribute sequence (colour, height) is reversed or cyclically shifted."@en ;
    arcm:taskCount 2 ;
    arcm:groundedIn arcm:math.permutation ,
        arcm:math.circular_shift .

arcm:ray.residual
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:RAY ,
        dul:Process ;
    rdfs:label "ray.residual"@en ;
    skos:definition "Tasks not covered by a generic primitive; reasons in \"reasons\"."@en ;
    arcm:taskCount 13 ;
    arcm:residual true .

arcm:connect.residual
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:CONNECT ,
        dul:Process ;
    rdfs:label "connect.residual"@en ;
    skos:definition "Tasks not covered by a generic primitive; reasons in \"reasons\"."@en ;
    arcm:taskCount 7 ;
    arcm:residual true .

arcm:path.residual
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:PATH ,
        dul:Process ;
    rdfs:label "path.residual"@en ;
    skos:definition "Tasks not covered by a generic primitive; reasons in \"reasons\"."@en ;
    arcm:taskCount 3 ;
    arcm:residual true .

arcm:project.residual
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:PROJECT ,
        dul:Process ;
    rdfs:label "project.residual"@en ;
    skos:definition "Tasks not covered by a generic primitive; reasons in \"reasons\"."@en ;
    arcm:taskCount 1 ;
    arcm:residual true .

arcm:crop.residual
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:CROP ,
        dul:Process ;
    rdfs:label "crop.residual"@en ;
    skos:definition "Tasks not covered by a generic primitive; reasons in \"reasons\"."@en ;
    arcm:taskCount 13 ;
    arcm:residual true .

arcm:select.residual
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:SELECT ,
        dul:Process ;
    rdfs:label "select.residual"@en ;
    skos:definition "Tasks not covered by a generic primitive; reasons in \"reasons\"."@en ;
    arcm:taskCount 8 ;
    arcm:residual true .

arcm:summarise.residual
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:SUMMARISE ,
        dul:Process ;
    rdfs:label "summarise.residual"@en ;
    skos:definition "Tasks not covered by a generic primitive; reasons in \"reasons\"."@en ;
    arcm:taskCount 8 ;
    arcm:residual true .

arcm:sort.residual
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:SORT ,
        dul:Process ;
    rdfs:label "sort.residual"@en ;
    skos:definition "Tasks not covered by a generic primitive; reasons in \"reasons\"."@en ;
    arcm:taskCount 2 ;
    arcm:residual true .

arcm:count.residual
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:COUNT ,
        dul:Process ;
    rdfs:label "count.residual"@en ;
    skos:definition "Tasks not covered by a generic primitive; reasons in \"reasons\"."@en ;
    arcm:taskCount 4 ;
    arcm:residual true .

arcm:sort.by_property
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:SORT ,
        dul:Process ;
    rdfs:label "sort.by_property"@en ;
    skos:definition "(named by another agent; to be defined)"@en ;
    skos:editorialNote "definition pending; grounded from the mechanism name only"@en ;
    arcm:taskCount 1 ;
    arcm:groundedIn arcm:math.sorting .

arcm:combine.fold_overlay
    a owl:Class ;
    rdfs:subClassOf arcm:Mechanism ,
        arcm:COMBINE ,
        dul:Process ;
    rdfs:label "combine.fold_overlay"@en ;
    skos:definition "(named by another agent; to be defined)"@en ;
    skos:editorialNote "definition pending; grounded from the mechanism name only"@en ;
    arcm:taskCount 1 ;
    arcm:groundedIn arcm:analogy.paper_folding ,
        arcm:math.reflection .

# ---------------------------------------------------------------- priors (domain priors: dul:Theory; families / aspects: dul:Method)
arcm:prior.topology
    a owl:Class ;
    rdfs:subClassOf arcm:Prior ,
        dul:Theory ;
    rdfs:label "TOPOLOGY prior"@en ;
    rdfs:comment "Invariants under continuous deformation of the grid read as a planar cell complex: holes/genus, containment tree, boundary contact, region adjacency, path-connected zones."@en ;
    arcm:domain "topology" ;
    arcm:status "implemented (round 1)" ;
    arcm:sourceFile "/home/claude/work/latent/prior_topology.py" ;
    skos:related <http://dbpedia.org/resource/Topology> ,
        wd:Q42989 ;
    arcm:groundedIn arcm:math.digital_topology ,
        arcm:math.jordan_curve_theorem ,
        arcm:math.genus ,
        arcm:math.euler_characteristic ,
        arcm:math.path_connectedness ,
        arcm:math.containment_tree .

arcm:prior.geometry
    a owl:Class ;
    rdfs:subClassOf arcm:Prior ,
        dul:Theory ;
    rdfs:label "GEOMETRY prior"@en ;
    rdfs:comment "Symmetry groups (D4 about arbitrary centres), lattices, glides and similarity transforms, fitted exhaustively."@en ;
    arcm:domain "geometry" ;
    arcm:status "implemented (round 1)" ;
    arcm:sourceFile "/home/claude/work/latent/prior_geometry.py" ;
    skos:related <http://dbpedia.org/resource/Geometry> ,
        wd:Q8087 ;
    arcm:groundedIn arcm:math.symmetry_group ,
        arcm:math.dihedral_group ,
        arcm:math.wallpaper_group ,
        arcm:math.lattice ,
        arcm:math.similarity .

arcm:prior.combinatorics
    a owl:Class ;
    rdfs:subClassOf arcm:Prior ,
        dul:Theory ;
    rdfs:label "COMBINATORICS prior"@en ;
    rdfs:comment "The output is a permutation of parts of the input, explained by generic permutation generators."@en ;
    arcm:domain "combinatorics" ;
    arcm:status "implemented (round 1)" ;
    arcm:sourceFile "/home/claude/work/latent/prior_combinatorics.py" ;
    skos:related <http://dbpedia.org/resource/Combinatorics> ,
        wd:Q76592 ;
    arcm:groundedIn arcm:math.permutation ,
        arcm:math.symmetric_group ,
        arcm:math.sorting .

arcm:prior.optics
    a owl:Class ;
    rdfs:subClassOf arcm:Prior ,
        dul:Theory ;
    rdfs:label "OPTICS prior"@en ;
    rdfs:comment "Opaque layers seen from above: painter's law, depth order from overlaps, amodal completion, projection, light rays reflected by mirrors."@en ;
    arcm:domain "optics" ;
    arcm:status "round 2, in progress (module read 2026-09-28)" ;
    arcm:sourceFile "/home/claude/work/latent/prior_optics.py" ;
    skos:related <http://dbpedia.org/resource/Optics> ,
        wd:Q14620 ;
    arcm:groundedIn arcm:analogy.occlusion ,
        arcm:math.painters_algorithm ,
        arcm:math.z_order ,
        arcm:analogy.amodal_completion ,
        arcm:principle.geometrical_optics ,
        arcm:analogy.shadow ,
        arcm:principle.specular_reflection .

arcm:prior.mechanics
    a owl:Class ;
    rdfs:subClassOf arcm:Prior ,
        dul:Theory ;
    rdfs:label "MECHANICS prior"@en ;
    rdfs:comment "Rigid bodies in mechanical equilibrium (rigidity, impenetrability, field, support) and common-sense machines (lock and key, lever)."@en ;
    arcm:domain "mechanics" ;
    arcm:status "round 2, in progress (module read 2026-09-28)" ;
    arcm:sourceFile "/home/claude/work/latent/prior_mechanics.py" ;
    skos:related <http://dbpedia.org/resource/Mechanics> ,
        wd:Q41217 ;
    arcm:groundedIn arcm:principle.mechanical_equilibrium ,
        arcm:principle.gravity ,
        arcm:math.rigid_transformation ,
        arcm:analogy.lock_and_key ,
        arcm:analogy.lever .

arcm:prior.fluids
    a owl:Class ;
    rdfs:subClassOf arcm:Prior ,
        dul:Theory ;
    rdfs:label "FLUIDS prior"@en ;
