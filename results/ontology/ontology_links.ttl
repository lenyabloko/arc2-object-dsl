# ---------------------------------------------------------------- physical principles
arcm:principle.gravity
    a arcm:Principle ;
    rdfs:label "gravity"@en ;
    rdfs:comment "Bodies are drawn in a field direction until supported."@en ;
    skos:exactMatch <http://dbpedia.org/resource/Gravity> ,
        wd:Q11412 .

arcm:principle.mechanical_equilibrium
    a arcm:Principle ;
    rdfs:label "mechanical equilibrium"@en ;
    rdfs:comment "Net force zero: bodies at rest once supported / balanced."@en ;
    skos:exactMatch <http://dbpedia.org/resource/Mechanical_equilibrium> ,
        wd:Q716915 .

arcm:principle.least_action
    a arcm:Principle ;
    rdfs:label "principle of least action (stationary action)"@en ;
    rdfs:comment "The realised path extremises the action; on the grid: shortest / straightest connection, minimal displacement."@en ;
    skos:closeMatch <http://dbpedia.org/resource/Action_principles> ;
    skos:exactMatch wd:Q722799 .

arcm:principle.conservation_law
    a arcm:Principle ;
    rdfs:label "conservation law"@en ;
    rdfs:comment "A measurable quantity (cell count, colour mass, object count) is invariant."@en ;
    skos:exactMatch <http://dbpedia.org/resource/Conservation_law> ,
        wd:Q205805 ;
    skos:related wd:Q483948 ,
        wd:Q578555 .

arcm:principle.fluid_flow
    a arcm:Principle ;
    rdfs:label "fluid flow"@en ;
    rdfs:comment "Liquid pours from sources, falls, spreads along supports and flows around obstacles."@en ;
    skos:exactMatch wd:Q12142910 ;
    skos:related <http://dbpedia.org/resource/Fluid_dynamics> ,
        wd:Q216320 .

arcm:principle.hydrostatics
    a arcm:Principle ;
    rdfs:label "hydrostatic equilibrium (filling to the spill level)"@en ;
    rdfs:comment "Liquid at rest fills a container bottom-up to a level surface."@en ;
    skos:exactMatch <http://dbpedia.org/resource/Hydrostatics> ,
        wd:Q177807 .

arcm:principle.diffusion
    a arcm:Principle ;
    rdfs:label "diffusion (spreading from sources)"@en ;
    rdfs:comment "Spreading from sources through free space, blocked by barriers."@en ;
    skos:exactMatch <http://dbpedia.org/resource/Diffusion> ,
        wd:Q163214 .

arcm:principle.geometrical_optics
    a arcm:Principle ;
    rdfs:label "rectilinear propagation of light (ray optics)"@en ;
    rdfs:comment "Light travels along straight rays and is stopped by opaque bodies."@en ;
    skos:closeMatch <http://dbpedia.org/resource/Geometrical_optics> ,
        wd:Q467980 ;
    skos:related <http://dbpedia.org/resource/Ray_(optics)> ,
        wd:Q633620 .

arcm:principle.specular_reflection
    a arcm:Principle ;
    rdfs:label "law of reflection (specular reflection)"@en ;
    rdfs:comment "A ray hitting a mirror line leaves at the mirrored angle."@en ;
    skos:exactMatch <http://dbpedia.org/resource/Specular_reflection> ,
        wd:Q1079524 .

arcm:principle.inertia
    a arcm:Principle ;
    rdfs:label "inertia"@en ;
    rdfs:comment "A moving body keeps its direction until something stops or deflects it."@en ;
    skos:exactMatch <http://dbpedia.org/resource/Inertia> ,
        wd:Q122508 .

